# ===== Database =====
# Kosongkan untuk memakai SQLite di data/monitor.db
DATABASE_URL=

# ===== Google Sheets (read-only cukup) =====
# ID spreadsheet dari URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=1CI1p_r8tGFztywALNbIT9yjjaMcwK_sphOhZ-Gnr8nA
# gid tab (0 = tab pertama)
GOOGLE_SHEET_GID=0
# Nama tab, hanya dipakai kalau pakai service account / writeback
GOOGLE_SHEET_TAB=pool

# Opsional: service account untuk writeback status ke sheet
GOOGLE_CREDENTIALS_FILE=secrets/service_account.json
SHEET_WRITEBACK=0

# ===== Jadwal otomatis =====
# Matikan untuk run pertama supaya 92 proxy tidak langsung dicek
AUTO_SYNC=1
AUTO_POLL=1
SYNC_INTERVAL_SECONDS=300
POLL_INTERVAL_SECONDS=900
POLL_CONCURRENCY=8

# ===== Proxy =====
# auto = coba socks5 lalu http. Bisa dipaksa: socks5 / http
PROXY_SCHEME=auto
REQUEST_TIMEOUT=20

# ===== EarnApp (opsional, untuk saldo) =====
# off = hanya monitoring proxy | mock = data palsu untuk uji UI | real = request asli
SCRAPER_MODE=off
EARN_APP_BALANCE_URL=
EARN_APP_BALANCE_PATH=balance
EARN_APP_LIFETIME_PATH=lifetime
EARN_APP_NODES_PATH=nodes_online
EARN_APP_AUTH_STYLE=cookie

# ===== Device monitoring dari API EarnApp =====
# Mengambil device, status online, usage harian, dan banned/IP dari
# https://earnapp.com/dashboard/me/passive-income/bandwidth
# Tidak bergantung pada SCRAPER_MODE; butuh cookie akun yang valid.
EARN_APP_API_BASE=https://earnapp.com/dashboard/api
EARN_APP_APP_VERSION=1.685.135
DEVICE_SYNC=1
DEVICE_USAGE_DAYS=14

# ===== Akses dari luar (HTTP Basic auth) =====
# Isi DASHBOARD_PASSWORD sebelum dashboard diekspos lewat tunnel.
# Kosong = dashboard hanya bisa diakses lokal tanpa login.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ===== Deploy 24/7 (Docker/VPS) =====
# Domain HTTPS untuk Caddy. Tanpa domain, pakai <IP-publik>.sslip.io
# Contoh: 203.0.113.10.sslip.io
DOMAIN=
# Opsional. Isi dengan isi secrets/secret.key kalau memindahkan database lama
# ke server yang tidak membawa folder secrets. Kalau kosong, app memakai file
# secrets/secret.key.
SECRET_KEY=
# Di server tanpa desktop, set LOGIN_HELPER=0 (lihat bagian Login Helper).
# HOST/PORT biasanya diatur oleh docker-compose.yml.

# ===== Login Helper (ambil cookie otomatis) =====
# Buka Chrome/Edge lewat proxy akun, login Google manual, cookie ditangkap otomatis.
LOGIN_HELPER=1
EARN_APP_LOGIN_URL=https://earnapp.com/dashboard
# Batas waktu satu sesi login (detik)
LOGIN_HELPER_TIMEOUT=900
# auto | chrome | msedge | chromium
LOGIN_HELPER_BROWSER=auto
# Profil browser per akun (jangan di dalam folder yang disinkronkan)
LOGIN_PROFILE_DIR=secrets/browser_profiles

# ===== Telegram (opsional) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=1800
